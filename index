rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi check adakah user ini Admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USER RULES
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // WALLET RULES (Hanya admin boleh ubah)
    match /wallets/{walletId} {
      allow read: if request.auth != null && (request.auth.uid == walletId || isAdmin());
      allow write: if isAdmin(); 
      allow create: if request.auth != null; // Benarkan wallet dicipta masa register
    }
    
    // WITHDRAWAL RULES
    match /withdrawals/{docId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin(); // Admin sahaja boleh approve/reject
    }
  }
}